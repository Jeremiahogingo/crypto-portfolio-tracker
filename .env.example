# Supabase project configuration (public client values; RLS remains required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged PostgreSQL connection used by Drizzle.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=

# Optional CoinGecko configuration. The base URL defaults to the v3 API.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_DEMO_API_KEY=
